APP_MODE=LIVE_REAL_MONEY
FEEDBACK_RELEASE=SESSION_FINISHED
FRAME_QUEUE_SIZE=2
CARD_TEMPLATE_DIR=
OCR_DECIMAL_SEPARATOR=.
POSTGRES_USER=zeros
POSTGRES_PASSWORD=zeros_local_dev
POSTGRES_DB=zeros
# Local development without DATABASE_URL uses SQLite; HAND_DB_PATH changes its path.

# Optional explanation editor; never sent to the browser. Set both key and model.
EXPLAINER_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=

# Source-time window for the bounded in-memory image history (10-30 seconds).
FRAME_BUFFER_SECONDS=10
